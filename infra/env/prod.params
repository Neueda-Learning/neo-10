# neo-10's OWN service (module 01: Portfolio & Regulatory Analytics), on prod. Identical to
# dev.params — a module carries no environment-specific values (the orchestrator URL is built
# from the Cloud Map namespace in the template). The pipeline adds EnvironmentName + the
# PINNED @sha256 images + DbEndpoint + AlbDnsName.
ServiceName=neo-10
Role=module
PathPrefix=/neo-10
ListenerRulePriority=100
DbName=neo_10
ServiceId=neo10
DisplayName=Portfolio & Regulatory Analytics
Domain=analytics
Team=Team 10
MockedDependencies=
